---
// Why: Merlive's mark, what it draws at its smallest: two boxes of one size on a straight line, and the one dot
// that follows the path when a reader asks. The boxes and the line are ink; the dot is the marigold, what
// Merlive adds to a Mermaid diagram.
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<svg class="mark" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  <rect x="5" y="0" width="14" height="7" class="box"></rect>
  <rect x="11" y="7" width="2" height="10" class="box"></rect>
  <rect x="5" y="17" width="14" height="7" class="box"></rect>
  <circle cx="12" cy="12" r="3.5" class="dot"></circle>
</svg>

<style>
  .mark {
    flex: none;
  }
  .box {
    fill: var(--ink);
  }
  .dot {
    fill: var(--mark);
  }
</style>
